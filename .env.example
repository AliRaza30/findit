# Flask Secret Key
SECRET_KEY=change-this-to-a-long-random-string

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

MONGO_DB_NAME=findit

# Optional: Cloudinary for cloud image storage (leave blank to store uploads locally)
CLOUDINARY_URL=
